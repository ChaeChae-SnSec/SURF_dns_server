# 복사해서 .env 로 쓰세요. .env 는 커밋되지 않습니다.

# SURF_AI_model 패키지를 import 할 수 있는 경로
PROJECT_ROOT=/srv/projects/surf
VENV_PATH=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Unbound 파이썬 모듈이 노출하는 메트릭 포트
PROMETHEUS_PORT=9101

# --- DoH 종단 ---
DOH_PORT=8053
# 프록시가 질의를 넘길 Unbound 주소
UNBOUND_HOST=127.0.0.1
UNBOUND_PORT=53
DOH_UDP_TIMEOUT=3.0
# 토큰 - 소스 주소 매핑 유지 시간(초). 질의마다 갱신된다.
TOKMAP_TTL=604800

DOH_WORKERS=1
DOH_THREADS=16
DOH_LOGLEVEL=warning
